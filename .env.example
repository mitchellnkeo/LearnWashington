# Supabase Postgres — Project Settings → Database → Connection string
# DATABASE_URL: Transaction pooler (port 6543). Used by the Next.js app.
# DIRECT_URL:   Session/direct URI (port 5432). Used by `pnpm db:migrate`.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Public site origin (no trailing slash)
WEB_ORIGIN=http://localhost:3000

# MapLibre style — OpenFreeMap Positron is the default if unset
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
MAP_STYLE_URL=
MAP_API_TOKEN=

# Optional. Leave empty until a Sentry project exists.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
