{
  "name": "@fwty/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:spatial": "RUN_SPATIAL_TESTS=1 vitest run src/spatial.test.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "content:check": "tsx src/content-check.ts",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fwty/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.7",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
